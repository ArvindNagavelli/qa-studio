# Copy to frontend/.env.local and fill in values. .env.local is gitignored.
# NEXT_PUBLIC_* values are embedded in the browser bundle: never put secrets here.

# Base URL of the backend API
NEXT_PUBLIC_API_URL=http://localhost:8000

# Google OAuth client ID (public identifier, same value as backend GOOGLE_CLIENT_ID)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=<your-client-id>.apps.googleusercontent.com

# Show the local-only dev login button. Must match backend DEV_LOGIN.
NEXT_PUBLIC_DEV_LOGIN=false
