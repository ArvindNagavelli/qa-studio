# Copy to backend/.env and fill in real values. backend/.env is gitignored.
# Placeholders only: never put real credentials in this file.

# development | test | production
APP_ENV=development

# Required. Async SQLAlchemy URL (asyncpg driver).
DATABASE_URL=postgresql+asyncpg://<user>:<password>@localhost:5432/qa_studio

# Required. Random string of at least 32 characters, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=<generate-a-random-string-of-at-least-32-chars>

# Google sign-in (OAuth client from Google Cloud Console)
GOOGLE_CLIENT_ID=<your-client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<your-google-client-secret>

# anthropic | mock   (mock needs no API key)
LLM_PROVIDER=mock
# Required only when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=<your-anthropic-api-key>

# Local-only password-less login for development. Rejected when APP_ENV=production.
DEV_LOGIN=false
